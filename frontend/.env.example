# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and will not be committed.

# Supabase project, used for the "Ring pasient" video/audio call to a patient's
# TV app. Without these the portal still runs, but the call button reports that
# Supabase is not configured.
# Find them in the Supabase dashboard under Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
